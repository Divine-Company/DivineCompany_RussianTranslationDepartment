  "dataList": [
    {
      "id": "0",
      "content": "<color=#293B95>Days of chasing shadows</color>"
    },
    {
      "id": "1",
      "content": "<color=#293B95>All that remains are vain memories</color>"
    },
    {
      "id": "2",
      "content": "<color=#293B95>Like a fire swept over me</color>"
    },
    {
      "id": "3",
      "content": "<color=#293B95>All that's in my hands is ashen dust</color>"
    },
    {
      "id": "4",
      "content": "<color=#293B95>I've run without rest</color>"
    },
    {
      "id": "5",
      "content": "<color=#293B95>The times that choked me</color>"
    },
    {
      "id": "6",
      "content": "<color=#293B95>Will I miss them as well?</color>"
    },
    {
      "id": "7",
      "content": "<color=#293B95>A long, long ways from now</color>"
    },
    {
      "id": "8",
      "content": "<color=#293B95>When I look back to those memories,</color>"
    },
    {
      "id": "9",
      "content": "<color=#293B95>I hope I can smile</color>"
    },
    {
      "id": "10",
      "content": "<color=#293B95>With however much time I have left</color>"
    },
    {
      "id": "11",
      "content": "<color=#293B95>Now I must move forward</color>"
    },
    {
      "id": "12",
      "content": "<color=#293B95>Burning myself up until I’m no more</color>"
    },
    {
      "id": "13",
      "content": "<color=#293B95>Like a candle that burns itself up</color>"
    },
    {
      "id": "14",
      "content": "<color=#293B95>Without a moment to breath</color>"
    },
    {
      "id": "15",
      "content": "<color=#293B95>I was thrown into turbulent days</color>"
    },
    {
      "id": "16",
      "content": "<color=#293B95>I hope I can go my way</color>"
    },
    {
      "id": "17",
      "content": "<color=#293B95>A long, long ways from now</color>"
    },
    {
      "id": "18",
      "content": "<color=#293B95>When I look back on those memories</color>"
    },
    {
      "id": "19",
      "content": "<color=#293B95>I sure wish that I can smile</color>"
    },
    {
      "id": "20",
      "content": "<color=#293B95>Let me, let me fly far so far away</color>"
    },
    {
      "id": "21",
      "content": "<color=#293B95>So I can reach the stars like a bird upon the night sky</color>"
    },
    {
      "id": "22",
      "content": "<color=#293B95>This night, this night will visit me again, I’m sure, but…</color>"
    },
    {
      "id": "23",
      "content": "<color=#293B95>It's alright, since I can live on</color>"
    },
    {
      "id": "24",
      "content": "<color=#293B95>It's alright</color>"
    }
  ]
}